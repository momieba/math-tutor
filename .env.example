# Supabase-Konfiguration (öffentlicher Anon-Key, KEIN service_role-Key!)
# Leer lassen => App läuft automatisch im lokalen Modus (localStorage + Mock-Auth).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: "local" erzwingt den lokalen Modus, auch wenn Supabase konfiguriert ist.
VITE_DATA_MODE=
