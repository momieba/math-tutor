# Supabase-Konfiguration (öffentlicher Anon-Key, KEIN service_role-Key!)
# Leer lassen => Entwicklungsserver (npm run dev) läuft automatisch im lokalen Modus (localStorage + Mock-Auth).
# Production-Builds starten ohne diese Werte NICHT (Konfigurationsfehler), außer VITE_DATA_MODE=local ist gesetzt.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: "local" erzwingt den lokalen Modus (Demo/E2E), auch wenn Supabase konfiguriert ist.
VITE_DATA_MODE=
